# Server
PORT=5058
ENVIRONMENT=Development
FRONTEND_URL=https://your-frontend-domain.com
BACKEND_BASE_URL=https://api.your-domain.com

# ===============================
# Database
DATABASE_URL=mongodb://USERNAME:PASSWORD@HOST:27017/DATABASE_NAME?authSource=DATABASE_NAME&replicaSet=rs0

# ===============================
# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=7d

# ===============================
# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===============================
# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_EMAIL=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_EMAIL_FROM=noreply@example.com
SMTP_NAME=YourAppName

# ===============================
# URLs
IMAGE_URL=http://localhost:5000
AI_BASE_URL=http://localhost:8888

# ===============================
# AWS S3
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_REGION=us-east-1
S3_BUCKET_NAME=your_bucket_name
S3_ENDPOINT=https://your-bucket.s3.amazonaws.com

# ===============================
# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password
CONTACT_EMAIL=contact@example.com

# ===============================
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# ===============================
# Google Calendar OAuth
OAUTH_CLIENT_ID=your_google_oauth_client_id
OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
OAUTH_REDIRECT_URL=https://your-domain.com/oauth/callback

# ===============================
# LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://api.your-domain.com/api/v1/auth/linkedin/verify

# ===============================
# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ===============================
# Puppeteer
PUPPETEER_SKIP_DOWNLOAD=false
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  fullName          String
  email             String           @unique
  password          String?
  profileImage      String           @default("")
  profession        String?
  location          String?
  experienceYear    String?
  bio               String?
  role              UserRole         @default(USER)
  isProMember       Boolean          @default(false)
  isDeleted         Boolean          @default(false)
  isBlocked         Boolean          @default(false)
  lastLogin         DateTime?
  subscriptionType  SubscriptionType @default(FREE)
  emailNotification Toggle           @default(ON)
  jobAlerts         Toggle           @default(ON)
  marketingEmails   Toggle           @default(ON)
  resumeLink        String?
  planEndsIn        DateTime?        @updatedAt
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  OTP               OTP?
  resumes           Resume?
  reflextions       Reflextion[]
  gigs              Gig[]
}

model Gig {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  industryName     String
  industryEmail    String
  gigTitle         String
  category         String
  source           Source          @default(MANUAL)
  description      String
  gigType          String
  exparienceLevel  ExparienceLevel @default(MID_LEVEL)
  duration         String
  location         String
  jobDescription   String
  responsibilities String[]
  benefits         String[]
  gigStatus        GigStatus       @default(ACTIVE)
  userId           String          @db.ObjectId
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  validUntil       DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model OTP {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  otpCode      String
  otpExpiresAt DateTime // Security timeout for OTP validation
  userId       String   @unique @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, otpCode]) // Ensure unique active OTPs per user
  @@index([otpExpiresAt]) // For cleanup of expired OTPs
}

model Resume {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  userId       String        @unique @db.ObjectId
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  title        String
  email        String
  location     String
  phone        String
  summary      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  expariences  Exparience[]
  education    Education[]
  resumeSkills ResumeSkill[]
}

model Exparience {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  resumeId    String    @db.ObjectId
  resume      Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  workingRole String
  companyName String
  description String
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Education {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  resumeId      String    @db.ObjectId
  resume        Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  degreeName    String
  instituteName String
  startDate     DateTime
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ResumeSkill {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  resumeId  String   @db.ObjectId
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  skillName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reflextion {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractedSkills String[]
  impectBullects  String[]
  shortSummary    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN

  @@map("userRole")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GigStatus {
  ACTIVE
  INACTIVE
}

enum Source {
  MANUAL
  IMPORTED
  AI_GENERATED
}

enum SubscriptionType {
  FREE
  PRO
  PREMIUM
}

enum ExparienceLevel {
  ENTRY
  MID_LEVEL
  EXPERT
}

enum Toggle {
  ON
  OFF
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model ActivityLog {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  userId      String       @db.ObjectId
  action      ActivityType
  description String?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id])
}

model AppliedGig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  gigId     String   @db.ObjectId
  gig       Gig      @relation(fields: [gigId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gigId, userId])
}

model Accomplishment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  date        DateTime
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  issueDate String?

  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId String @db.ObjectId
}

// Models in alphabetical order
model Education {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  resumeId      String   @db.ObjectId
  resume        Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  degreeName    String
  instituteName String?
  startDate     String?
  endDate       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Experience {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  resumeId    String   @db.ObjectId
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  workingRole String?
  companyName String?
  description String?
  startDate   String?
  endDate     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gig {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  industryName     String
  industryEmail    String
  gigTitle         String
  category         String
  source           Source          @default(MANUAL)
  description      String
  gigType          String
  experienceLevel  ExperienceLevel @default(MID_LEVEL)
  duration         String
  location         String
  jobDescription   String[]
  responsibilities String[]
  benefits         String[]
  gigStatus        GigStatus       @default(ACTIVE)
  userId           String          @db.ObjectId
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  validUntil       DateTime
  embedding        Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  savedGigs        SavedGig[]
  appliedGigs      AppliedGig[]
}

model Invoice {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  userId             String        @db.ObjectId
  user               User          @relation(fields: [userId], references: [id])
  stripeInvoiceId    String        @unique
  amount             Float
  currency           String        @default("usd")
  status             InvoiceStatus
  planName           String // e.g. "Starter Pro"
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  invoiceUrl         String? // Stripe hosted invoice PDF link
  createdAt          DateTime      @default(now())
}

model OTP {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  otpCode      String
  otpExpiresAt DateTime // Security timeout for OTP validation
  userId       String   @unique @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, otpCode]) // Ensure unique active OTPs per user
  @@index([otpExpiresAt]) // For cleanup of expired OTPs
}

model Plan {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  monthlyPrice    Float
  stripePriceId   String?
  stripeProductId String?
  features        String[]
  type            SubscriptionType
  isActive        Boolean          @default(true)
  isDeleted       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  link        String?
  techStack   String[] // ["Python", "FastAPI"]
  description String[] // multiple bullet points
  startDate   String?
  endDate     String?

  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId String @db.ObjectId
}

model OtherLink {
  id   String  @id @default(auto()) @map("_id") @db.ObjectId
  type String?
  link String?

  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId String @db.ObjectId
}

model Language {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String // "English (Native)"

  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId String @db.ObjectId
}

model Reflextion {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractedSkills String[]
  impectBullects  String[]
  shortSummary    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Resume {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  userId       String        @unique @db.ObjectId
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  title        String?
  email        String?
  location     String?
  phone        String?
  summary      String?
  embedding    Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  experiences  Experience[]
  education    Education[]
  skills       Skill[]
  projects     Project[]
  otherLinks   OtherLink[]
  languages    Language[]
  certificates Certificate[]
}

model Skill {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  resumeId         String?          @db.ObjectId
  resume           Resume?          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  userId           String?          @db.ObjectId
  user             User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillName        String
  skillCategory    String
  proficiencyLevel ProficiencyLevel @default(Beginner)
  yearOfExperience Int              @default(0)
  source           SkillSource      @default(MANUAL)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, skillName])
}

model SavedGig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  gigId     String   @db.ObjectId
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gigId])
}

model User {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  fullName             String
  email                String             @unique
  password             String?
  profileImage         String             @default("")
  profession           String?
  location             String?
  experienceYear       String?
  bio                  String?
  role                 UserRole           @default(USER)
  isDeleted            Boolean            @default(false)
  isBlocked            Boolean            @default(false)
  lastLogin            DateTime?
  subscriptionType     SubscriptionType   @default(FREE)
  emailNotification    Toggle             @default(ON)
  jobAlerts            Toggle             @default(ON)
  marketingEmails      Toggle             @default(ON)
  // manager role 
  isManagerAllowed     Boolean?
  resumeLink           String?
  resumeParseCount     Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  // subscription
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?
  subscriptionStatus   SubscriptionStatus @default(INACTIVE)
  currentPeriodEnd     DateTime?
  OTP                  OTP?
  resumes              Resume?
  reflextions          Reflextion[]
  gigs                 Gig[]
  invoices             Invoice[]
  skills               Skill[]
  accomplishments      Accomplishment[]
  activityLogs         ActivityLog[]
  savedGigs            SavedGig[]
  appliedGigs          AppliedGig[]
}

// Enums in alphabetical order
enum ActivityType {
  SAVED_GIG
  APPLIED_GIG
  UPDATED_SKILLS
  ADDED_PROJECT
  VIEWED_SNAPSHOT
  UPLOADED_RESUME
}

enum ExperienceLevel {
  ENTRY
  MID_LEVEL
  EXPERT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GigStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  PAID
  UNPAID
  FAILED
}

enum Source {
  MANUAL
  IMPORTED
  AI_GENERATED
}

enum SubscriptionType {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum SkillSource {
  RESUME
  MANUAL
  RECOMMENDATION
}

enum Toggle {
  ON
  OFF
}

enum UserRole {
  USER
  ADMIN
  MANAGER
}

enum ProficiencyLevel {
  Beginner
  Intermediate
  Advanced
  Expert
}
